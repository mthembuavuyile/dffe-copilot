    "quickstart": "node examples/quickstart.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "sitemap:check": "node scripts/generate-sitemap.js --check",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "dffe",
    "dffe-copilot-beta",
