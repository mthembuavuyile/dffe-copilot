{
  "name": "dffe-copilot",
  "version": "1.0.0-beta.1",
  "description": "DFFE Copilot — Environmental Intelligence & RAG Assistant for the Department of Forestry, Fisheries and the Environment (DFFE), Republic of South Africa.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cli": "node src/cli/chat-cli.js",
