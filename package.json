  },
  "license": "MIT",
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0"
  }
}
